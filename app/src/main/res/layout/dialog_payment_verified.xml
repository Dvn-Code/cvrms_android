<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/card_bg"
        app:strokeWidth="1dp"
        app:strokeColor="@color/border_soft">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/ivVerifiedBadge"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:src="@drawable/ic_check_circle_gold"
                android:contentDescription="Verified Checkmark"
                android:layout_marginBottom="14dp" />

            <TextView
                android:id="@+id/tvVerifiedTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Payment Verified"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/primary_dark"
                android:gravity="center"
                android:letterSpacing="0.02" />

            <TextView
                android:id="@+id/tvVerifiedSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CASA VISTA RESORT RESERVATION"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/welcome_gold"
                android:letterSpacing="0.1"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp" />

            <!-- Amount Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_day_circle_gold"
                android:backgroundTint="#F8F4EA"
                android:padding="14dp"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL AMOUNT PAID"
                    android:textSize="11sp"
                    android:textColor="@color/text_muted"
                    android:letterSpacing="0.08" />

                <TextView
                    android:id="@+id/tvVerifiedAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₱0.00"
                    android:textSize="26sp"
                    android:textStyle="bold"
                    android:textColor="@color/status_green"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Details Box -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="#FAF8F5"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Booking Reference"
                        android:textSize="13sp"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/tvVerifiedBookingRef"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CV-00000"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary_dark" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Transaction ID"
                        android:textSize="13sp"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/tvVerifiedTxnRef"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PAYMAYA-0000"
                        android:textSize="13sp"
                        android:textColor="@color/primary_dark" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Cloud Sync Status"
                        android:textSize="13sp"
                        android:textColor="@color/text_muted" />

                    <TextView
                        android:id="@+id/tvVerifiedSyncStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirmed &amp; Synced"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/status_green" />
                </LinearLayout>
            </LinearLayout>

            <!-- Done Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerifiedDone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:text="Done / View Booking Details"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="@color/primary_dark"
                app:cornerRadius="12dp"
                app:elevation="2dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</ScrollView>
